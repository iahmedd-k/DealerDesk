DATABASE_URL=postgresql+psycopg://dealerdesk:change-me@localhost:5432/dealerdesk
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
AUTH_RATE_LIMIT=10/minute
# Optional OpenAI-compatible embeddings endpoint. Local hash embeddings are used when unset.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# SQLAlchemy connection pool settings.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# DealerDesk Platform Admin Credentials
DEALERDESK_ADMIN_NAME=DealerDesk Admin
DEALERDESK_ADMIN_EMAIL=dealerdesk@demo.com
DEALERDESK_ADMIN_PASSWORD=replace-with-a-unique-password

# Configure these when switching to Supabase.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_ID=brand-logos
VEHICLE_IMAGES_BUCKET_ID=vehicle-images

# Google Workspace shared mailbox (Google OAuth Web application credentials).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/email/google/callback
# Generate a URL-safe base64 encoding of 32 random bytes; keep this key private.
GMAIL_TOKEN_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:3000

# Configure each dealership's inbound number in its Settings page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_STATUS_CALLBACK_URL=
